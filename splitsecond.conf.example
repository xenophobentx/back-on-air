# splitsecond.conf - next to dinput8.dll (the patch). No file: the DLL does nothing at all.
#
# fps: 30 = the game as it ships (nothing is patched), 60 = the game's logic at 60 ticks a second.
# (same key and values as the port's own splitsecond.conf)
# Above 60 (docs/plan-120fps.md): 120 (the overlay's FRAME RATE row offers 30, 60 and 120), native (the display's
# refresh rate) or a number from 61 to 240 (these two in this file only). Single-player races then run their simulation in 1/fps steps; menus, loading, movies and
# the pause stay at 60. Known limits at these rates: a rewind reaches 360/fps seconds, and only the steering of
# the cars' handling has been compared with 60 (hfr_steering). (SS_HFR = 0 | 1 | <number> | native)
fps = 60
# hfr_ticks: sixty (default) = scripted sequences (timelines) advance by game time in every update that runs slowed:
# the camera slow motion's half steps at fps = 60 (where they ran at double pace against the cars) and every update
# of a race above 60. raw = one frame per tick, as before. (SS_HFR_TICKS)
# hfr_ticks = sixty
# With fps above 60:
# fps_scope = race      race: only the race runs above 60; all: other states too (not yet)
# hfr_rewind = capped   capped: the crash / takedown rewind requests ask for their time in ticks of the rate;
#                       off: they reach 60/fps of it
# hfr_steering = scaled scaled: the steering lock has the physics step in it (the wheels turned half as far at 120);
#                       its gain is multiplied by fps/60 while a race runs in 1/fps steps. off: the game's values

# Controllers. Every connected XInput pad is shown to the game as a wired Xbox 360 pad (the one pad the game
# has bindings for), in XInput slot order, with rumble routed to the right pad. Off: the game sees what Windows
# or Proton gives it, as before. (The port has no controller rows in its settings page; these keys are new.)
pad_support = true
# Vibration. pad_rumble_gain is a percentage of what the game asks for (0-200).
pad_rumble = true
pad_rumble_gain = 100
# Radial dead zone of each stick and trigger threshold, percent of the travel. The game applies a dead zone of its own on top.
pad_deadzone_left = 6
pad_deadzone_right = 6
pad_trigger_threshold = 5
# The game looks for pads once, at start. true (default): offer all four XInput slots from the start, so a pad switched
# on or plugged in later works (the empty slots show up as pads that do nothing).
pad_hotplug = true
# Pads that exist only in DirectInput (no XInput): read as an Xbox pad (Sony, Nintendo and generic layouts).
pad_translate_dinput = true
# true: report nothing while another program's window is in front.
pad_foreground_only = false
# true: throttle (RT) and brake (LT) work at the same time (brake or drift on the gas). The game reads both
# triggers from one Z axis, as on a stock Xbox 360 pad; the patch gives each action its own trigger while the
# game reads it. Bindings and the save stay as they are. false: one shared axis, holding both cancels out. Read at start.
pad_split_triggers = true
# Log button changes to splitsecond-patch.log (the first 400). Default false.
pad_log = false
# Keyboard: a held arrow key keeps moving in the menus (car selection, lists): one step at once, then from 0.4 s on
# 10 a second, the stick's repeat. false: one step per press, as the game ships. (SS_MENU_KEY_REPEAT)
menu_key_repeat = true
# reverb: the PC release ships its event files with the authored per-environment reverb presets
# (hall, large hall, tank, overhead, hangar, take-down camera, loading screen, default ambient) overwritten by
# one generic small room. true = give the game the authored parameters back (the console release's), by
# preset name, as it reads them from the event system. Default true when this file exists. (SS_REVERB=0|1)
reverb = true
# reverb_level: a trim on the reverb's level, in percent (overlay: AUDIO > REVERB LEVEL, live). 100 = the presets as
# authored (the default); 50 = the reverb 6 dB lower, 0 = no reverb. It lowers the Room level of whatever preset the
# game sets (the hangar and the halls are authored 10 dB above the open track); placement and decay stay.
# (SS_REVERB_LEVEL=0..100)
reverb_level = 100
# console_mix: the mix preset (overlay: AUDIO > SOUND MIX). The PC release ships a later revision of about 20
# event volumes / pitches (tyres, swooshes, helicopter, HUD, downtown collapse, ...) and some re-recorded samples
# at other levels (HUD ticks up to 12 dB, power play debris and rolls 2-9 dB). false = PC ORIGINAL, the PC's own event
# values; true = XBOX 360, those events get the Xbox 360 values (78 event values, table generated by
# tools/audio/fev_compare.py), only while they hold the PC value, and the crash camera loop's five sound instances
# their console volumes (5-11 dB lower; set as the file loads, so at start). Switches live from the overlay for the
# event values, for the sounds started from then on. Default true (a missing key included). (SS_CONSOLE_MIX=0|1)
console_mix = true
# audio_sidechain: the game's side-chain ducking (DynamicMixer.xml: collisions duck music -2 dB and the engines
# -5 dB, power plays duck collisions -6, surfaces -12 and the engines -6, speech ducks music and swooshes, the HUD
# ducks music -3). It listens to a volume meter on every audio group; the PC release creates those meters but never
# puts them in FMOD's DSP network, so nothing ever ducks. true = put them in (their channel group: the one the
# group's filters went to, or the category of that name). Measured on a race: music -2 dB, engines -5 dB within
# 0.2 s of an impact, as the file sets out. Default true. (SS_AUDIO_SIDECHAIN=0|1)
audio_sidechain = true
# audio_voice_dsp: 3D placement (front / back / side, distance filtering) of the sounds the game places itself,
# opponent cars among them. Each such sound has its own small DSP unit that does the placement; the PC release
# creates the units but never connects them, so those sounds come out of every speaker alike and never move.
# true = connect them, as the console does; false = as shipped. Default true. While it is on, audio_speaker_fix
# below is not applied (the full speaker levels it removes are the units' input). (SS_AUDIO_VOICE_DSP=0|1)
audio_voice_dsp = true
# audio_speaker_fix: 5.1 placement of 2D sounds. The PC release sets the centre, both rear and the LFE level of
# almost every 2D event (collisions, swooshes, tyres, power plays, camera) to full, so on a 5.1 system they come out
# of all six speakers. The event files (the same as the console's) put them on the front pair. true = keep the event
# files' levels (the console placement); false = as shipped. Default true. (SS_AUDIO_SPEAKER_FIX=0|1)
audio_speaker_fix = true
# audio_stereo_mix: the mix on a stereo device (speakers, headphones). The game always has FMOD mix 5.1 and leaves
# Windows to fold the six channels down to two, and Windows' fold plays them about 8 dB quieter (measured on a race:
# -27 LUFS, peaks at a quarter of full scale). auto = on Windows, when the device's speaker setting is stereo, FMOD
# mixes stereo itself (centre and rear sounds folded into left and right), with a limiter that holds the mix at
# -1 dBFS so a loud moment does not clip; a 5.1 or 7.1 device keeps the game's 5.1 mix, and so does Wine (Proton,
# Steam Deck), whose fold keeps the level. on = the stereo mix under Wine too (stereo devices only). off = always
# 5.1, as shipped. Default auto. Takes effect at the next game start. If the game is now too loud, lower the volume
# in the game's options, or set off for the old level. (SS_AUDIO_STEREO_MIX=auto|on|off)
audio_stereo_mix = auto
# audio_cpu_engines: the opponents' engine sounds. Each opponent's engine bank is loaded into a buffer whose size
# the PC release kept from the Xbox 360 (104,857 bytes); the PC banks are 148..203 KB, so the game refuses every
# one and the opponents are silent all race (stock too). true = the buffers are 256 KB, the banks load and the
# engines play (and a play the game's range check would refuse is started anyway); false = as shipped.
# Default true. Takes effect at the next game start. (SS_AUDIO_CPU_ENGINES=0|1)
audio_cpu_engines = true
# audio_fsb_fix: where each sound of a sound bank starts. The PC banks (.fsb) start every sound's data on a 32-byte
# boundary, but FMOD on PC adds up the lengths without those gaps and starts reading up to 2 KB early: the last
# 26..105 ms of the sound before it play first and as much is missing at the end. Heard on the result screens, whose
# music loops: a short piece of another track at every loop. true = the header is corrected as FMOD reads it (no
# file is changed); false = as shipped. Default true. Takes effect at the next game start. (SS_AUDIO_FSB_FIX=0|1)
audio_fsb_fix = true
# audio_diag: log the FMOD DSP network, the DSPs the game creates, the events it fetches and starts (with their
# parameters) and every change of the game's per-category volumes (ducking), for diagnosis.
# audio_diag = false
# audio_music_log: a time line of the game's music in the log ([music_log] lines), for a report of music that should
# not play: every start, stop and pause of a music or speech event, and every larger move of the music, speech and
# master volumes the game asks for (fades, mutes, ducking). Changes no sound. Default false. (SS_AUDIO_MUSIC_LOG=1)
# audio_music_log = false

# Mixer: a volume per group, in percent of what the game plays (0-200, 100 = unchanged). The overlay offers 0-120 and
# warns that above 100 the sound may distort (clip); a value above 120 set here is kept, the overlay shows it and its
# left steps it down toward 120. They multiply the game's own music / effects sliders, fades and ducking, never
# replace them. FMOD caps every group at full scale, so more than 100 only gives back what the game itself turns
# down (its sliders below the top, ducking under speech).
# All at 100 (and sfx_trim = 0): nothing is hooked. The values can also be changed live from the in-game overlay.
# (SS_VOLUME_MASTER, SS_VOLUME_MUSIC, ...)
volume_master = 100
volume_music = 100
# effects: collisions, Power Plays and their explosions, slow motion, debris, passing whooshes, tyres/surfaces,
# the take-down camera, menu and HUD sounds (every category no other group names)
volume_sfx = 100
# engines: the player's car and the other cars
volume_engines = 100
# voice: the race announcer / speech
volume_voice = 100
# ambience: level ambience beds and spot ambience
volume_ambience = 100
# Per category, on top of the group above (the game's category tree has nothing finer). Same 0-200 percentages.
# volume_player_engine = 100      your car's engine
# volume_opponent_engines = 100   the other cars' engines
# volume_collisions = 100         crashes and impacts
# volume_powerplays = 100         Power Plays and their explosions
# volume_swooshes = 100           passing whooshes
# volume_surfaces = 100           tyres and road surfaces
# volume_particles = 100          debris
# volume_hyperreal = 100          the HyperReal category (slow-motion effects)
# volume_camera = 100             camera effects
# volume_hud = 100                menu and HUD sounds
# volume_general_ambience = 100   level ambience beds
# volume_spot_ambience = 100      spot ambience

# mixer_map: optional, which FMOD event categories a group covers, replacing the default for the groups named.
# Category names as in the log line "[mixer] category tree:"; "*" = every other top-level category. Default:
# master:master; music:music; engines:PlayerEngine,CPUEngine; voice:Speech; ambience:Ambience,Spot_Ambience; sfx:*
# e.g. mixer_map = engines:PlayerEngine,CPUEngine,Surfaces   (SS_MIXER_MAP)
# mixer_map =
# mixer: true = put the mixer's hooks in at start even with every group at 100 (logs the category tree). (SS_MIXER)
# mixer = false

# sfx_trim: older flat gain in dB (0 = off, the default; only negative values act, down to -24) on every top-level
# category except music, speech and HUD (engines and ambience included). Still works, on top of the groups above.
# (SS_SFX_TRIM=<dB>)
sfx_trim = 0
# sfx_trim_categories: optional comma separated list of category names to trim instead of the default
# selection, e.g. sfx_trim_categories = Collisions,Powerplays   (SS_SFX_TRIM_CATEGORIES)
# sfx_trim_categories =
# button_prompts: the button pictures of the prompt bar (A SELECT, B BACK, the popups, Start), like the console port.
#   auto        - the device used last: the keyboard's key caps, or the pictures of the pad's kind (Valve / Steam Deck ->
#                 steam, Sony -> playstation, Nintendo -> nintendo, Xbox 360 -> xbox360, other pads -> xbox; on a
#                 handheld, SteamDeck=1 or SS_HANDHELD=1, the Xbox kinds -> steam). Under Steam Input the pad Steam
#                 names behind its virtual pad counts.
#   xbox360     - the game's own Xbox 360 buttons
#   xbox        - Xbox One / Series: A B X Y with coloured rings, the menu button
#   playstation - the game's own PlayStation 3 symbols (cross, circle, square, triangle, Start)
#   nintendo    - letters by position (the game's A is printed B, its X is Y), a plus for Start
#   steam       - light letters on dark buttons, the menu button
#   keyboard    - the key caps the PC build draws (the bound key's name)
# A pad control the game writes as text (the Controls screen, the hints) is named by the set too (LB, RT, LS Up instead
# of "Button 5", "Left Axis Neg Z"); keyboard keeps the game's names.
# xbox, nintendo and steam are drawn by the DLL (no picture file). The older key pad_glyphs is still read when this one
# is absent (pad = xbox360). (SS_BUTTON_PROMPTS; SS_GLYPH_SURVEY=1 logs the small textures the game uploads)
button_prompts = auto

# The crash / takedown camera slow motion and the takedown close-up replay; at fps = 60 both would run at double speed.
# true: every second slowed update is held so they play at their real speed (the port's SS_REPLAY_SLOW_HOLD).
takedown_realtime = true
# With takedown_realtime at fps = 60: true runs every slowed update of the live camera slow motion at half the tick
# time through the game's own time scale (60 different pictures a second); playback does the same for the takedown
# replay too; false holds every second slowed update (30 pictures, each shown twice).
# (SS_SLOW_HALF_STEP = 0 hold, 1 live slow motion only, 2 live + replay)
slow_half_steps = true

# Frame pacing: the overlay's DISPLAY > SCREEN SYNC row (restart).
#   auto (default) - picks for the machine: smooth everywhere for now (Windows, desktop Linux, Steam Deck, any fps).
#   smooth         - every frame waits for the display's vblank: no tearing, about one frame of added latency. The
#                    presents sit on a fixed 1/fps grid that follows the display (under gamescope / Steam Deck the
#                    display's clock, not the PC's, decides which frame is shown; an unsynced 60 drifts in and out of
#                    phases that look like 30 fps). vsync is the older spelling.
#   fastest        - the same grid without the wait: the device presents at once (interval IMMEDIATE, whatever the
#                    game's own vsync option says). Lowest latency; the picture can tear.
# In this file only (the row names them when set):
#   vrr     - for a display with variable refresh (G-Sync / FreeSync) active for the game: on the vblank as smooth,
#             but the race rate is held under the display's refresh (min(hz - 3, hz - hz*hz/3600): fps = native
#             or 120 on a 120 Hz display gives 116, 144 Hz gives 138) and the grid runs on the PC's clock, so a
#             late frame is shown a little late instead of a whole refresh late. Judders on a display without VRR.
#   present - the grid only; the game's own vsync option (or game_vsync) decides about the vblank.
#   step    - the wait before the work only (as before the grid).
# On a 90 Hz Steam Deck OLED set the refresh rate to 60 Hz (Performance menu): 60 frames cannot be even at 90 Hz;
# the same for a 144 Hz monitor (60 or 120 Hz). Every change needs a restart. (SS_FRAME_PACING)
frame_pacing = auto
# A [frames] line every 10 s: fps, frame interval avg / sd / min / max, 1% low, late frames. Default false.
frame_log = false
# The game's main loop sleeps "1 ms" after every frame (its own yield). With the patch's pacing the wait before the
# work is the frame's rest, and this second sleep only takes time from the frame (about 5 ms of 16.7 on a Steam
# Deck: frames with more than ~11 ms of work came late with the CPU and GPU far from busy). auto (the default): left
# out while the patch paces the presents; game: kept. The [frames] split line shows the time outside the step and
# this sleep's part either way. Needs a restart. (SS_LOOP_SLEEP)
loop_sleep = auto
# Before every frame the game asks Windows whether there is a network connection (InternetGetConnectedState). On
# Windows that is cheap; under Proton it walks the network adapters each time: about 4.3 ms of every 16.7 ms frame on
# a Steam Deck, on the main thread. auto (the default): a thread of the patch asks every 10 s and the game gets the
# last answer; game: the game's own call every frame. Needs a restart. (SS_NET_POLL)
net_poll = auto

# Save backups. At every start the files of the save folder (Documents\Disney Interactive Studios\Split Second\:
# the *.sav profile and config_ss.cfg; under Proton inside the prefix) are copied into a new folder
# save-backups\YYYY-MM-DD_HHMMSS\ next to this file (not into Documents: Steam Cloud syncs that folder). No new folder
# when the saves have not changed since the newest backup. The newest N folders are kept (0-50); 0 = off.
# (SS_SAVE_BACKUPS)
save_backups = 10

# Unlocks (overlay GAME page; live; off while you are online). Memory only: the patch never writes your save. While
# on, the menus show the content as unlocked; off gives the game's own locks back. But what you play meanwhile is
# saved by the game as usual (a race won in a locked event counts). So turning one on first copies the save into
# save-backups\before-unlock-YYYY-MM-DD_HHMMSS\ (kept for good, not counted in save_backups); if that copy fails the
# switch stays off. From the online sign-in until you leave online play all three are held off.
#   unlock_all: every event, track, game mode and car.
#   bonus_content: the PC cheat-code extras (Expressway, Cobretti SlipStream, the retailer cars, the Euro livery pack).
#   pure_decal: the decal for owning a save of the game Pure.
# The decals (achievements) have no key here: they change the save for good, so they are only two-press actions in
# the overlay (GAME > UNLOCK ONLINE DECALS / UNLOCK ALL DECALS), with a backup into save-backups\before-decals-...
# The game saves the decals only when you finish a race and press CONTINUE on the results. To undo, restore the
# oldest before-decals- folder: a later press makes a newer one that already holds the decals.
unlock_all = false
bonus_content = false
pure_decal = false

# Which Direct3D 9 the game draws with on Windows. Read at start-up.
#   dxvk: DXVK (Direct3D 9 on Vulkan), from the dxvk folder next to this file. Holds 120 fps and gives HDR. Each
#         track stutters a little the first time it is driven, until the graphics driver has cached its pipelines.
#   native: Windows' own Direct3D 9. No stutter in the race, only a short pause as it starts; about 110 fps when
#         aiming for 120 (fine at 60); no HDR.
# A d3d9.dll next to the exe (the older install layout) is always used and this key does nothing; remove it to let
# the key choose. No effect on Linux / Steam Deck: Proton always draws with its own DXVK.
renderer = dxvk

# DXVK on Windows (renderer = dxvk, the way to HDR on Windows). The exe has 2 GB of address
# space; without this the race load runs out of it. auto: on Windows, when the game draws with DXVK, the DLL
# keeps one Direct3D object for the whole run (the Vulkan driver is then loaded once; every reload of AMD's driver
# loses 128 MB) and threads of DLLs get a 1 MB stack instead of the exe's 5 MB. false: off. true: on with any d3d9
# on Windows. Nothing on Linux / Proton. (SS_DXVK_FIT)
dxvk_fit = auto
# The engine name DXVK gives the Vulkan driver. dxvk (the default): "DXVK", as DXVK ships. auto: a test for issue #2
# (Windows HDR turns off while the game is in front on NVIDIA; NVIDIA's Windows driver is reported to take an engine
# named "DXVK" off HDR): when an NVIDIA display adapter is present, DXVK's Vulkan instance is named "BackOnAir"
# instead, and asks for VK_EXT_swapchain_colorspace (the extension of the HDR10 colour space) when the driver offers
# it. Not tried on NVIDIA yet; the driver may tie other DXVK handling to the name too. force: renamed on any GPU (a
# test). Windows with DXVK only; nothing on Linux / Proton. Log line "[renderer] Vulkan instance".
dxvk_engine_name = dxvk
# Environment variables for this process, set before Direct3D starts (the exe restarts itself on Windows and loses
# the launcher's environment). One line each, e.g.:
#   env.DXVK_HUD = fps
#   env.VK_LOADER_LAYERS_DISABLE = ~implicit~
# Diagnostic, off by default: the address space in splitsecond-patch.log every N seconds ([vm] lines: free space,
# largest free block, who holds what), also when an allocation fails and at a crash. (SS_VM_LOG)
#vm_log = 10
# DLC test overlay (experimental, SSPC-12; docs/dlc-overlay.md). A folder (relative to the game folder, or absolute)
# whose files stand in for the game's files of the same relative path when the game opens them for reading, e.g. a
# rebuilt data\resident.ark made by tools/dlc/overlay_car_gate1.py. The stock files are never changed; remove the
# key (or the folder) and the stock game is back. Empty = off. (SS_OVERLAY_DIR)
overlay_dir =
# Extra track ids from <overlay_dir>\dlc-tracks.txt (tools/dlc/overlay_clone_track.py writes it). (SS_DLC_TRACKS)
dlc_tracks = false
# auto: while dlc_tracks adds a track, the game keeps its save in <Documents>\Split Second DLC profile\... instead
# of the stock save folder; on / off force it. (SS_DLC_SAVE_PROFILE)
dlc_save_profile = auto

# Boot movies. true: pad #0 taps A while the boot movies play, so the game skips them along its own path (needs
# pad_support); the title screen comes in about 14 s instead of 75. The disclaimer page stays its few seconds.
# (SS_SKIP_INTRO=0|1)
skip_intro = true
# Boot to the main menu. true: the title screen's Press Start is passed for you (the game's own path, pad 0), the
# profile loads and the main menu comes with no button pressed. Your own first button or key press hands control
# back. A first start without a profile stops at the profile creation (a name to type). Default: as skip_intro.
# (SS_BOOT_TO_MENU=0|1)
#boot_to_menu = true
# Texture filtering (same key and values as the port's ANISOTROPY row). N: every linear-filtered texture with mips is
# filtered anisotropically at N, whatever the game asked, and N caps what it asks of the others; textures without mips
# (render targets, colour look-ups) and volume / cube textures are never filtered anisotropically. off: none at all.
# game (the default, PC ORIGINAL in the menu): the game's own rule (anisotropic at the device's maximum at quality
# HIGH / VERY HIGH only). (SS_ANISOTROPY)
anisotropy = game

# Scenery LOD distances (the port's DRAW DISTANCE): console = each level's own values (the PC's are the console's);
# 1.5 / 2 = the high and low distances and their fades times the factor, the mid distance and the streaming radius
# kept, and the visibility map's LOD caps off so the distance alone decides (for the idle power-play objects too); the
# knock-over props (200 m) and the opponents' off distance (200 m as the PC loads it, the Nemesis trucks' 200 m) take the factor too.
# Particles (smoke, sparks) keep their full emission to the factor times their 150 m / 200 m LOD distances.
# More draws and streaming. (SS_DRAW_DISTANCE)
draw_distance = console

# The game's visibility lists (SCENERY VISIBILITY): game = as the game (above console draw distance the scenery's LOD
# caps and the idle power plays' check are off, as described above); off = the whole visibility map off at any draw
# distance: every sector and every car, power play and other moving thing inside its distance is drawn, also behind
# buildings (no occlusion culling), so less appears in one frame at a corner, a tunnel or a crest (the seclusion zones
# too). More draws and more full meshes asked of the 57 MB streaming pool; split screen pays it for every view. Keep
# game on the Steam Deck until it is measured there. (SS_VISIBILITY_LISTS)
visibility_lists = game

# The sun shadow's reach (the port's SHADOW DISTANCE): console = 300 m with a 100 m fadeout (the PC's values are the
# console's); 1.5 / 2 = range and fadeout times the factor. The first cascade stays where the game has it (about
# 35 m), the last one covers the added distance with the same 1024 texels, so far shadows are softer. At quality
# LOW / MEDIUM the level's own shadow numbers are scaled the same way. (SS_SHADOW_DISTANCE)
shadow_distance = console

# The sun shadow's texels (this patch's own): console = the game's three 1024x1024 cascades in a 1024x3072 atlas (as
# on the Xbox 360); 2048 / 4096 = the atlas is made 2 / 4 times as wide and high and the cascades drawn at that size.
# Sharper shadow shapes (fences, poles, wheels, the stair steps along edges go away); the soft edge keeps its width
# (shadow_softness). GPU memory +72 MiB at 2048, +360 MiB at 4096; 4096 is for a desktop GPU, not a Steam Deck.
# Split screen keeps 1024. Needs a restart. (SS_SHADOW_RESOLUTION)
shadow_resolution = console

# The sun shadow's hand-over between its cascades (the port's SHADOW SMOOTHING): off = the game's hard line where the
# sharp near cascade turns into the coarser next one (25 to 35 m ahead of the camera, so it runs along in front of the
# car and shadows change their look as it crosses them); on / high = a dithered band of 25 % / 40 % of each split
# before it, the coarser cascade taking a growing share of the pixels. The shaders that read the splits get a variant
# (made on first use, nothing in the game's code). Changes at once from the menu when it was on at start.
# Default high (a missing key included). (SS_SHADOW_SMOOTHING)
shadow_smoothing = high

# The sun shadow's filter radius (this patch's own). Every shadow reader takes 8 taps around the pixel in the shadow
# map, turned by a fixed noise, and counts the lit ones: 9 shades over a penumbra the game sets to 1.56 texels of the
# near cascade (1.04 and 0.52 of the coarser ones). console = that; 1.25 / 1.5 = a wider, softer edge that hides the
# 1024-texel steps better; 0.75 = sharper and more jagged. Too wide brings stripes on slopes and thinner contact
# shadows (the game's depth bias is tuned for its radius and is not scaled), so the steps stay modest. The same shader
# variants as shadow_smoothing; changes at once from the menu while that hook is in. With aa = taa / taa_high the
# taps' noise also turns a little every jittered frame, so TAA averages the 9 shades into a smooth edge (no cost; off
# without TAA, where it would shimmer; SS_SHADOW_ROTATE=0 turns it off for a comparison). (SS_SHADOW_SOFTNESS)
shadow_softness = console

# Debanding (this patch's own): the game's tone mapper and colour grade cut the picture to 8 bits with no dither, so
# dark gradients, fog, bloom halos and the vignette show steps. on = their shaders get a variant (made on first use,
# nothing in the game's code) that adds half a step of a fixed per-pixel noise before the 8-bit write; TAA's copy-out
# and sharpening add the same. A value on an exact colour code stays on it. off = the game's shaders. Default on
# (pending the owner's look on the Deck). Changes at once from the menu when it was on at start. (SS_DEBAND)
deband = on

# Speed blur (the game's screen-space motion blur, only at its QUALITY High / Very High). It blurs along one frame's
# camera motion, so at 60 fps it is half as long as at 30 and at 120 a quarter. console = its amount x fps / 30 (at most
# x4), the edges clamped so the longer blur brings in no line at the bottom: the length the game was tuned for at 30;
# game = as the PC release; off = no blur. Changes at once from the menu. (SS_MOTION_BLUR)
motion_blur = console

# How the speed blur is drawn. low and high = this patch's own shader (used while the game's blur pass runs): one
# sample per 4 pixels of streak with a fine noise between them, so the streaks are smooth instead of the game's 9
# repeated copies, and another car's colour no longer smears into the background behind it. high = 8 to 24 samples,
# low = 6 to 12 (at the game's QUALITY Very High high acts as low). Same streak length and direction as the game's
# (that is motion_blur's). game = the game's own blur shader. Default high, on a Steam Deck low. Changes at once from
# the menu. (SS_MOTION_BLUR_QUALITY)
# motion_blur_quality = high

# The game's vignette (darker corners), the light gradient across the top of the picture and the sun / light lens
# flares: game = as the game shows them, off = not drawn. Change at once from the menu. (SS_VIGNETTE,
# SS_SCREEN_GRADIENT, SS_LENS_FLARE)
vignette = game
screen_gradient = game
lens_flare = game

# Camera shake from explosions and Power Plays (the game's DisallowAllCameraShake switch): game = on, off = no shake.
# Camera only, online-safe. Changes at once from the menu. (SS_EXPLOSION_SHAKE)
explosion_shake = game

# Scenery mesh changes (the port's LOD SMOOTHING): off = the game's one-frame switch between an object's simple and
# full mesh (at the mid LOD distance, and when the full mesh has streamed in); on / high = both are drawn for half a
# second / a second with an 8x8 screen-door dither, the new one taking over pixel by pixel; scenery that the game's
# visibility map switches on fades in the same way. Moving assets and power-play set pieces (the airport's radars,
# ...) fade in and out over the last 30 m / 60 m of their draw distance instead of appearing in one frame. The sun
# shadows of all of these fade with them, and a shadow that switches mesh on its own fades too. Knock-over props
# (posts, signs, barrels) fade over the last 30 m / 60 m of their draw distance, which changes gradually.
# Default on (a missing key too). (SS_LOD_SMOOTHING)
lod_smoothing = on

# Opponent cars' LOD rule (the port's CAR DETAIL). The PC release loads the PS3 rule (far LOD from 100 m, mid LOD for
# three opponents at most); console = the Xbox 360's (far from 200 m, no limit on mid LODs); high = console plus the
# near body for every opponent in the near range and full textures on every car; pc = as the PC release ships. (SS_CAR_DETAIL)
opponent_cars = console

# The draft streaks at the front of the car (the Xbox 360's slipstream effect, missing on PC): true rebuilds the
# streaks' texture from the PC data as it loads (8 of its 16 frames are missing and the rest half height in the PC
# files) and sets the one misplaced byte that makes the streaks move with the car. Files are not changed. Read at
# start-up. (SS_SLIPSTREAM_FIX)
slipstream_fix = true
# Memory for streamed track detail (the sector streaming pool): game = the game's 57 MB (the Xbox 360's size, full on
# PC); a number in MB (the overlay offers 70) gives far objects more room before they drop to low detail. The game has
# 512 slots for streamed items: once 480 are in use the size is held at what is then used for the rest of that
# level. Takes effect at the next level load. stream_pool_log = 1 logs the pool once a second.
stream_pool = game
# Window mode. fullscreen: the game as it ships (exclusive fullscreen; nothing is hooked). borderless: a window
# without frame over the whole monitor (alt-tab is instant, no device reset); windowed: a window with a title bar,
# the size of the game's resolution. In both the picture is the game's resolution scaled to the window, so set the
# game's resolution to the monitor's for borderless. Under gamescope / Steam Deck leave it at fullscreen.
# (SS_WINDOW_MODE)
window_mode = fullscreen
# One more resolution in the game's RESOLUTION list, for borderless and windowed only: <width>x<height>, for example
# 2560x1080 to play (or try) a 21:9 picture in a window on a 16:9 monitor. The game otherwise offers only the
# monitor's modes and replaces any other size in its settings file with one of them. Empty: the list as it is.
# (SS_EXTRA_RESOLUTION)
# extra_resolution = 2560x1080

# false: the game keeps running (and keeps its sound) when another window is in front; true: it mutes and pauses a
# race as it ships. (SS_PAUSE_ON_FOCUS_LOSS)
pause_on_focus_loss = true
# The game installs a keyboard hook for the whole desktop: every key pressed in any program can wait for the game, and
# it is meant to block the Windows key and Alt+Tab. off: the patch leaves it out (other programs' shortcuts cannot be held up by
# the game, also with it minimised; the Windows key and Alt+Tab work in front of the game). on: the game's hook as it ships.
# (SS_GAME_KEY_HOOK)
game_key_hook = off

# Device resets (alt-tab in fullscreen, resolution changes) into the log; a failed reset lists the video-memory
# objects the game did not release, with the code that created them. (SS_DISPLAY_LOG)
display_log = false

# The game's own vsync option (kept in its binary config_ss.cfg), overridden at device creation and reset:
# game = as the game asks (the default), off = never wait for the vblank (the patch's present pacing then keeps the
# frame rate), on = always on the vblank. frame_pacing wins: smooth / auto still puts the device on the vblank, fastest
# takes it off; with frame_pacing = present or step this key alone decides. Not in the overlay.
# (SS_GAME_VSYNC=game|off|on)
game_vsync = game
# Anti-aliasing of the 3D picture (the PC release has none at any quality level): off, fxaa, smaa (SMAA 1x), taa or
# taa_high.
# Applied when the 3D picture is finished and before the HUD and menus are drawn on it, so text and icons stay sharp.
# taa: temporal anti-aliasing: the picture is drawn moved by a fraction of a pixel every frame and each
# frame is blended with the last result (moved by the camera's motion through the game's depth), so thin things
# (fences, wires, foliage, far edges) stop shimmering in motion. The cheap one: about the cost of FXAA.
# taa_high: the same after SMAA 1x on every frame: cars that pass and places that come into view are
# anti-aliased too. Costs about as much as smaa and taa together. Split screen has neither.
# sharpen = 0.25 suits both.
# Default smaa (a missing key too). (the port's own splitsecond.conf has off, fxaa, smaa; SS_AA)
aa = smaa
# With aa = taa or taa_high: the game's textures are sampled a little sharper (a negative mip LOD bias) while the
# picture is jittered, since the jittered frames add up to more detail than one frame shows: -2..0, 0 = off. Not on the HUD,
# the menus or the patch's own passes. Read at start. (SS_TAA_LOD_BIAS)
taa_lod_bias = -0.5
# With aa = smaa: also find edges from the game's depth (SMAA's depth predication): cleaner edges where the depth
# jumps (cars, posts, fences, the sky line), less blur on texture detail and painted text. Colour only when the depth
# cannot be read. true or false. (SS_SMAA_PREDICATION)
smaa_predication = true
# Sharpening of the 3D picture (contrast adaptive): 0 (off), 0.25, 0.5, 0.75 or 1. After the anti-aliasing. (SS_SHARPEN)
sharpen = 0
# The patch's shaders (anti-aliasing, sharpening, HDR) are compiled on a worker thread: a mode picked in the menu
# takes over once they are ready, the old one stays on screen meanwhile. true: the compiled shaders are also kept in
# shader-cache\ beside the DLL, so the next start and switch need no compile (delete the folder at any time).
# (SS_SHADER_CACHE)
shader_cache = true
# Pre-compile (DXVK only; menu: GRAPHICS > PRE-COMPILE). The first race on a track stutters while DXVK builds its
# Vulkan pipelines. With pre-compile on, they are built while the track loads: no stutter, but the first load of each
# track takes about 30 s instead of 5 s (once per driver cache). It needs the record files in pipeline-warmup\ beside
# the DLL (they ship with the patch; shader hashes and states only, no game code). With it on, DXVK gets 4 compiler
# threads (more free memory) unless you set numCompilerThreads yourself; that part needs a restart.
# Values: empty or auto = on when the record files are there; on; off. For developers: record = write new
# combinations to pipeline-warmup\local\<level>.bin; both = on + record. (SS_PIPELINE_WARMUP, SS_PIPEWARM_SLICE_MS)
# GRAPHICS > PRE-COMPILE ALL TRACKS builds every track at once from the main menu (README: Pre-compile).
pipeline_warmup = auto
# In-game settings (PC SETTINGS), drawn over the game: F1, or hold a pad's Back/View button for 0.7 s. Up/down rows,
# left/right changes the value and writes it into this file at once (comments kept), A/Enter opens an action row,
# B/Esc closes, LB/RB or Q/E pages. Pages DISPLAY, HDR, GRAPHICS, AUDIO, CONTROLLER, GAME, ADVANCED; a help line under
# the rows says what the focused row does. Rows marked RESTART are read at start; RESTART NEEDED: changed, takes
# effect at the next start. The game keeps running behind it (open it from the game's pause menu in a race).
# false: no overlay, nothing hooked for it. (SS_MENU=0|1)
menu = true
# true: also a DEVELOPER page (logs, test switches, the 120 fps measuring switches, any row the menu does not list
# for players). Read each time the overlay opens. (SS_MENU_DEVELOPER)
menu_developer = false
# A Y prompt on the game's own Options screen, PC SETTINGS (in the game's language), that opens the in-game settings
# above: Y on a pad, Tab on the keyboard (the game's key for Y). The Options screen stays as it was when they close.
# false: the Options screen as shipped, nothing hooked for it. Needs menu = true. (SS_OPTIONS_PROMPT=0|1)
options_prompt = true
# Picture shape (the port's rows: aspect, hud_width). The PC build keeps the horizontal field of view of a 16:9
# screen on every screen (on 21:9 / 32:9 the top and bottom are cut off) and stretches the whole interface over the
# screen. auto: the scene is widened for a screen wider than 16:9 (the 16:9 picture's height, more at the sides;
# 16:10 keeps the game's own picture, more above and below) and the HUD and the menus are drawn in an undistorted
# box in the middle; the letterbox bars and the transition wipes still span the screen. 16:9: as the game ships.
# A shape (16:10, 21:9, 32:9, <w>:<h>) is used instead of the back buffer's (for a display mode whose pixels are not
# square). (SS_ASPECT)
aspect = auto
# The interface box on a screen wider than 16:9: 16:9 (undistorted), 21:9 (stretched to 21:9), full (the game's own
# stretch). A 16:10 screen (Steam Deck) keeps the game's full-screen interface, except with letterbox: the 16:9 box
# with bars above and below there (on a wider screen letterbox is the same as 16:9). (SS_HUD_WIDTH)
hud_width = 16:9
# The scene's vertical field of view in percent of the game's (50-150; 100 = the game's). (SS_FOV)
fov = 100
# Test switch: false widens the scene only after the game's update, as before 2026-11-13 (culled and motion-blurred
# with the 16:9 camera at the sides). Leave it unset. (SS_ASPECT_CULLING)
# aspect_culling = true

# HDR output (the port's rows: same keys, values and defaults; docs/plan-hdr.md). The light the game's own tone
# mapper clips at white (the sun's glare, fire, sparks, lamps, the sky) is worked out again from the tone mapper's
# inputs and shown above paper white on an HDR10 display; the SDR picture underneath, the HUD and the menus stay the
# game's. Needs DXVK (Proton / Steam Deck / Bazzite: it is there) and a display in HDR: on the Steam Deck OLED or
# Bazzite, Game Mode with HDR switched on for the display. Where HDR10 is not offered the picture is the SDR one,
# silently. The rows are on the DISPLAY page of the in-game settings (F1), with a calibration screen; HDR switches
# on and off there at once. (SS_HDR=0|1)
hdr = false
# HDR ready (default true): the device gets a 10-bit back buffer at start (the game's own format when that is
# refused) and the HDR hooks go in, so the HDR row can switch HDR on live. With HDR off the passes do not run and the
# picture is the SDR one. false, with hdr = false: nothing of HDR is hooked, the back buffer is the game's own, and
# the HDR row takes effect at the next start. (SS_HDR_READY=0|1)
# hdr_ready = true
# Peak brightness in nits. 0: what the display reports (else 1000). (SS_HDR_PEAK)
# hdr_peak = 0
# The game's ordinary white in nits (120-400). Default 240, on a Steam Deck 200. (SS_HDR_PAPER_WHITE)
# hdr_paper_white = 240
# The HUD's and the menus' white in nits. 0: auto, 0.8 x paper white. (SS_HDR_HUD)
# hdr_hud = 0
# Deeper darks: a power on the picture below mid grey. 1 (off), 1.05, 1.1, 1.2. (SS_HDR_SHADOWS)
# hdr_shadows = 1
# How far the light goes above paper white: 1 (the game's level), 1.25, 1.5, 2, 3. (SS_HDR_HIGHLIGHTS)
# hdr_highlights = 1.5
# LIGHT SOURCES (the port's row): 0 (off), 1, 2, 3 (default), 4. What the game itself knows to be a light is taken
# above the sunlit whites: coronas and glow cards (the additive sprites, drawn once more into a target of their own),
# lamp lenses, LED boards and bulbs (the self-lit materials, found by their shaders), fire, sparks and explosions
# (the particles' own light; these stay on at 0, as in the port). (SS_HDR_LIFT)
# hdr_lift = 3

# Test aid, not a feature: the HDR feasibility probe (docs/plan-hdr.md, src/hdr_probe.cpp). Lists the device, DXVK's swap
# chain extension and chosen frames (render targets, full-screen passes, their shaders and constants) in
# splitsecond-hdr-probe.txt. (SS_HDR_PROBE; more keys in docs/plan-hdr.md, section 13)
# hdr_probe = true
# Online (experimental). The game's own ONLINE menu looks for splitsecpclive.quazal.net (UDP 31120), which no longer
# exists. A host name (or an address) here: that lookup (every *.quazal.net name) is answered with this server's
# address instead, by a jump on ws2_32.dll's gethostbyname. A name is resolved once at start; the lookups are logged
# as "[online]" lines. The port stays 31120. Empty (the default, also with no such line): the project's replacement
# server, vps4954.rackhostvps.com, as built into the DLL, so a later DLL that names another server needs no change
# here. off: nothing is hooked and the game stays offline. (SS_ONLINE_SERVER)
online_server =
# With online_server set: sign in by itself (no name or password to type). The name other players see is your Steam
# name plus a 3-character tag ("Racer-7QK"); the password is made from splitsecond-online.key beside the DLL
# (created on first use; copy it to keep your account on another PC; without it you get a new tag, so a new name and
# a new account; the uninstaller keeps it). false: the
# game's own dialog asks for a name and a password. The log line "[online] sign-in name" says where the name came from.
# online_autologin = true
# Another name instead of the Steam name (letters, digits, space . _ -; up to 12 characters are used; the tag is added).
# online_name =
# With online_server set: how races reach the other players (the peer tunnel).
#   auto   (default) direct first; a player who cannot be reached directly within 2 s is reached through the
#          server's relay (UDP 31122). No port forwarding is needed.
#   always every race datagram goes through the server, and the server gives no other player your address (a little
#          more ping).
#   off    no tunnel: the game's own direct connections only, as in 1.0.4.
#   Players with the tunnel (auto, always) and without it (off, 1.0.4 and older) see only rooms of their own kind.
# online_relay = auto
# With online_server set: log the lobby's start conditions (read only) as "[online-probe]" lines when they change.
# (SS_ONLINE_PROBE)
# online_probe = true
